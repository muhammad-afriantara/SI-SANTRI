# Konfigurasi Database MongoDB
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DB_NAME=si_santri_db

# Konfigurasi Keamanan JWT (gunakan string acak yang panjang & rahasia)
JWT_SECRET=ganti_dengan_secret_key_acak_yang_kuat
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Password default untuk akun siswa/guru baru atau fitur reset password admin
DEFAULT_PASSWORD=password123
