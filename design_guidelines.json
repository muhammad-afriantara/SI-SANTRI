  "form_wizard_specification": {
    "title": "Form Pantauan Harian (5 Langkah)",
    "description": "Form terpandu yang ringan dan cepat diisi setiap hari",
    "steps": [
      {
        "step": 1,
        "key": "sholat",
        "title": "A. Sholat Fardhu 5 Waktu",
        "icon": "mosque",
        "prayers": ["Subuh", "Dzuhur", "Ashar", "Maghrib", "Isya"],
        "options": [
          { "value": "Berjamaah", "badge_color": "emerald", "points": 10 },
          { "value": "Munfarid", "badge_color": "blue", "points": 8 },
          { "value": "Berhalangan", "badge_color": "amber", "points": 7 },
          { "value": "Tidak Sholat", "badge_color": "rose", "points": 0 }
        ]
      },
      {
        "step": 2,
        "key": "tidur",
        "title": "B. Waktu Tidur & Bangun",
        "icon": "moon-stars",
        "fields": [
          { "name": "waktu_tidur", "label": "Jam Tidur Malam", "default": "21:30", "quick_choices": ["20:30", "21:00", "21:30", "22:00", "22:30", "23:00+"] },
          { "name": "waktu_bangun", "label": "Jam Bangun Pagi", "default": "04:15", "quick_choices": ["03:30", "04:00", "04:15", "04:30", "05:00", "05:30+"] }
        ]
      },
      {
        "step": 3,
        "key": "nutrisi",
        "title": "C. Asupan Nutrisi Harian",
        "icon": "apple-alt",
        "type": "multi_select",
        "categories": [
          { "id": "karbohidrat", "label": "Karbohidrat", "examples": "Nasi, Singkong, Roti, Kentang" },
          { "id": "vitamin", "label": "Vitamin & Mineral", "examples": "Sayur Bayam, Buah Pisang/Jeruk" },
          { "id": "protein", "label": "Protein (Lauk)", "examples": "Tempe, Tahu, Telur, Ikan, Ayam" }
        ]
      },
      {
        "step": 4,
        "key": "kegiatan_ortu",
        "title": "D. Kegiatan Bersama Orang Tua",
        "icon": "hands-helping",
        "type": "multi_select_with_other",
        "options": [
          "Makan Bersama",
          "Membantu Pekerjaan Rumah (Menyapu/Mencuci)",
          "Mengobrol/Curhat Santai",
          "Belajar/Ditemani Belajar",
          "Sholat Berjamaah di Rumah",
          "Lainnya"
        ],
        "other_text_field": "kegiatan_ortu_lainnya"
      },
      {
        "step": 5,
        "key": "belajar",
        "title": "E. Aktivitas Belajar Mandiri",
        "icon": "book-open",
        "type": "multi_select_with_other",
        "options": [
          "Mengerjakan PR / Tugas Sekolah",
          "Membaca Buku Pelajaran / Mengulang Materi",
          "Membaca Al-Qur'an / Tadarus",
          "Belajar Kursus / Bimbingan Belajar",
          "Membaca Buku Non-Pelajaran / Literasi",
          "Lainnya"
        ],
        "other_text_field": "belajar_lainnya"
      }
    ]
  },
